        variant_outputs, save_fig=True, zoom_efuel=True, directory_filename=str(FIG_DIR / f"jet_fuel_{family}")
    , title=f"Jet Fuel - {family} - Mid Tech")
    plot_variants_worlds_fleet_carriers(
        variant_outputs, save_fig=True, zoom_battery=True, directory_filename=str(FIG_DIR / f"fleet_carriers_{family}")
    , title=f"Fleet Carriers - {family} - Mid Tech")
