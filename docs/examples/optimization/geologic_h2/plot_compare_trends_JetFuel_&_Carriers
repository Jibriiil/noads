            )
            for world in WORLDS
        }
        for variant, flags in VARIANTS.items()
    }
    for family, drop_in_only in FAMILIES.items()
}

# %% Figures : 2 families x 3 types = 6 figures
# outputs[family][variant][world] = output_optimal 
# family: "drop-in" / "breakthrough"; variant: "trend" / "availability" / "low-demand"
# world: "NoGeoH2" / "GeoH2-2" / "GeoH2-LowAlt-2"
for family, variant_outputs in outputs.items():
    plot_variants_worlds_trends(
        variant_outputs, save_fig=True, directory_filename=str(FIG_DIR / f"trends_{family}")
    ,title=f"Trends - {family} - Mid Tech")
